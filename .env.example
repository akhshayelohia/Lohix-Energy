# Copy to .env for local development. Set the same names in Vercel → Project → Settings →
# Environment Variables for the live site. Never commit real keys.

# --- Supabase (public values, already used by the site) ---
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-id>"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# --- Auto-reply emails for warranty registrations and dealer applications (server-only) ---
# Without RESEND_API_KEY the forms still save submissions; emails are simply skipped.
# 1. Create a Resend account (resend.com) and an API key with "Sending access".
# 2. Add and verify the lohixenergy.com domain in Resend (it gives you DNS records to add).
RESEND_API_KEY=""
# Sender shown to customers; the domain must be verified in Resend.
EMAIL_FROM="LOHIX Energy <hello@lohixenergy.com>"
# Where the team's "new submission" notifications go (comma-separated).
# Optional: falls back to the contact email set in /admin → Global settings.
EMAIL_TEAM_TO=""
